# Database:
# - Local development defaults to sqlite:///./portfolio.db
# - Vercel production MUST set DATABASE_URL (PostgreSQL via Neon/Supabase/Vercel Postgres)
#   for persistent writes; otherwise Vercel falls back to ephemeral /tmp/portfolio.db.
DATABASE_URL="sqlite:///./portfolio.db"

# Gemini API Key for "Ask Ajey" natural-language responses (optional; falls back to keyword FAQ engine)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CORS Allowed Frontend Origins (comma-separated; APP_URL and VERCEL_URL are added automatically)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Admin Credentials & Session Secret (change before production deployment)
ADMIN_USERNAME="ajey_admin"
ADMIN_PASSWORD="change_this_secure_password"
ADMIN_SESSION_SECRET="replace_with_a_64_char_random_secret"

# Directory for uploaded certificates and bundled assets
PUBLIC_ASSETS_DIR="../public"
