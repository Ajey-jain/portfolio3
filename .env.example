# GEMINI_API_KEY: Required for Gemini AI API calls in the "Ask Ajey" assistant.
# If omitted, the assistant runs on the deterministic grounded FAQ engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Deployed production origin (e.g. https://your-portfolio.vercel.app)
APP_URL="MY_APP_URL"

# PostgreSQL connection string for persistent production storage on Vercel
# (Neon / Supabase / Vercel Postgres). If omitted on Vercel, falls back to
# ephemeral /tmp/portfolio.db SQLite storage.
DATABASE_URL=""

# Comma-separated CORS allowed origins (VERCEL_URL / APP_URL are auto-included)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Admin Dashboard Authentication (REQUIRED to override in Vercel Environment Variables)
ADMIN_USERNAME="ajey_admin"
ADMIN_PASSWORD="change_this_secure_password"
ADMIN_SESSION_SECRET="replace_with_a_long_random_secret_key"

# Frontend API Base URL:
# Leave unset/empty for single-project Vercel deployment (uses relative /api routes).
# VITE_API_BASE_URL=""
